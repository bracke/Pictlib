with "jpeglib";
with "textrender";
with "config/pictlib_config.gpr";

library project Pictlib is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/pictlib";
   for Library_Dir use "lib";
   for Library_Name use "pictlib";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   --  The checks are part of the library's contract with hostile input and stay on in every profile; Alire's
   --  build profile chooses only the optimization and debug information.
   Checks := ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnato", "-gnatVa", "-gnatwa", "-gnatwe");

   package Compiler is
      case Pictlib_Config.Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use Checks & ("-O2");
         when others =>
            for Default_Switches ("Ada") use Checks & ("-Og", "-g");
      end case;
   end Compiler;
end Pictlib;
