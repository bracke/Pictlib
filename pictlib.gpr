with "jpeglib";
with "textrender";

library project Pictlib is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/pictlib";
   for Library_Dir use "lib";
   for Library_Name use "pictlib";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnato", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;
end Pictlib;
