project Pictlib_Proof is
   for Source_Dirs use ("../src");
   for Object_Dir use "../obj/proof";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnato", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=0");
   end Prove;
end Pictlib_Proof;
