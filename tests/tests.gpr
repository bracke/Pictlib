with "../pictlib.gpr";
with "textrender";
with "aunit";
with "project_tools";

project Tests is
   for Source_Dirs use ("src", "src/mains");
   for Main use ("pictlib_tests.adb", "pictlib_conformance.adb", "pictlib_real_world.adb", "pictlib_prove.adb", "pictlib_fuzz.adb", "pictlib_check.adb", "pictlib_benchmark.adb", "pictlib_complete.adb", "pictlib_generate.adb");
   for Object_Dir use "obj/tests";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnato", "-gnatVa", "-gnatwa");
   end Compiler;
end Tests;
